# ===== 敏感配置项（请勿提交到版本控制） =====
# 此文件包含所有敏感信息，如 API keys、密码、密钥等
# 复制此文件为 .env.secrets 并填入实际值
# .env.secrets 已在 .gitignore 中，不会被提交到版本控制

# ===== MySQL数据库敏感配置 =====
MYSQL_PASSWORD=your_password

# ===== 大模型API密钥 =====
LLM_API_KEY=sk-your-dashscope-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# ===== 管理后台认证密钥 =====
JWT_SECRET_KEY=your-secret-key-change-me-to-random-string-in-production
ADMIN_PASSWORD_HASH=$2b$12$your-password-hash-here

# ===== 微信配置（敏感信息） =====
WECHAT_SECRET=your-wechat-secret-here
WECHAT_TOKEN=your-wechat-token-here

# ===== 微信支付配置（敏感信息） =====
WECHAT_PAY_MCHID=your_merchant_id_here
WECHAT_PAY_API_KEY=your_api_key_here

# ===== 七牛云CDN密钥（敏感信息） =====
QINIU_ACCESS_KEY=your_qiniu_access_key_here
QINIU_SECRET_KEY=your_qiniu_secret_key_here

# ===== 地理位置API密钥 =====
GAODE_API_KEY=your-gaode-api-key-here

