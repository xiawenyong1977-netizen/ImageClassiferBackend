# ===== MySQL数据库配置 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
# MYSQL_PASSWORD 已移至 .env.secrets 文件
MYSQL_DATABASE=image_classifier
# MYSQL_UNIX_SOCKET 可选，如果指定将优先使用socket连接（例如：/opt/mysql3307/mysql.sock）
# MYSQL_UNIX_SOCKET=/opt/mysql3307/mysql.sock
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=5

# ===== 大模型API配置 =====
# 支持的提供商：aliyun（阿里云通义千问）、openai、claude、deepseek
LLM_PROVIDER=aliyun
# LLM_API_KEY 和 DEEPSEEK_API_KEY 已移至 .env.secrets 文件

# 任务类型对应的模型配置（系统会根据任务类型自动选择对应的模型）
# 支持的模型列表请参考 app/services/llm/model_config.py
# 
# 阿里云（Aliyun/Qwen）:
#   - 图像分类: qwen-vl-plus
#   - 图像编辑: qwen-image-edit
#   - 文本生成: qwen-turbo, qwen-plus, qwen-max
# OpenAI:
#   - 图像分类: gpt-4-vision-preview, gpt-4o
#   - 图像编辑: 不支持
#   - 文本生成: gpt-4, gpt-3.5-turbo
# Claude:
#   - 图像分类: claude-3-opus, claude-3-sonnet, claude-3-haiku
#   - 图像编辑: 不支持
#   - 文本生成: claude-3-opus, claude-3-sonnet
# Deepseek:
#   - 图像分类: 不支持
#   - 图像编辑: 不支持
#   - 文本生成: deepseek-chat
#
# 如果不指定，系统会根据提供商和任务类型自动选择默认模型
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_IMAGE_EDIT=

# ===== 任务类型对应的模型配置 =====
# 如果不指定，系统会根据提供商和任务类型自动选择默认模型
# 支持的模型列表请参考 app/services/llm/model_config.py
LLM_MODEL_CLASSIFICATION=
LLM_MODEL_IMAGE_EDIT=

# ===== 任务类型对应的参数配置 =====
# 如果不指定，系统会根据模型自动选择默认值
# 图像分类任务参数
LLM_MAX_TOKENS_CLASSIFICATION=
LLM_TIMEOUT_CLASSIFICATION=
LLM_MAX_RETRIES_CLASSIFICATION=
LLM_RETRY_DELAY_CLASSIFICATION=

# 图像编辑任务参数（图像编辑通常需要更长的超时时间）
LLM_MAX_TOKENS_IMAGE_EDIT=
LLM_TIMEOUT_IMAGE_EDIT=
LLM_MAX_RETRIES_IMAGE_EDIT=
LLM_RETRY_DELAY_IMAGE_EDIT=

# ===== 本地推理配置 =====
# 是否使用本地推理（开启后不调用大模型）
USE_LOCAL_INFERENCE=false
# 大模型失败时是否降级到本地推理
LOCAL_INFERENCE_FALLBACK=false

# ===== 应用配置 =====
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_ENV=production

# ===== 图片配置 =====
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png,webp,gif

# ===== 日志配置 =====
LOG_LEVEL=INFO
LOG_FILE=/var/log/image-classifier/app.log

# ===== 统计配置 =====
ENABLE_REQUEST_LOG=true
LOG_RETENTION_DAYS=90

# ===== 成本配置（用于统计） =====
COST_PER_API_CALL=0.01

# ===== 提示词配置 =====
# 提示词配置优先级（从高到低）：
# 1. 环境变量（.env 文件中手动设置，用于特殊覆盖）
# 2. prompts/ 目录下的文件（如果存在，自动读取，用于版本控制）
# 3. config.py 中的默认值（如果文件不存在，使用此默认值）
#
# 提示词文件：
#   - prompts/classification.txt      # 图片分类提示词
#   - prompts/color_classification.txt # 颜色分类提示词
#   - prompts/composition_analysis.txt # 构图分析提示词
#   - prompts/face_fortune.txt        # 面相预测提示词
#   - prompts/reverse_geocoding.txt   # 逆地址编码提示词
#
# 如需自定义提示词，推荐方式：
#   1. 修改 prompts/ 目录下对应的文件（推荐，便于版本控制）
#   2. 或者在 .env 文件中设置环境变量（用于特殊覆盖）：
#      CLASSIFICATION_PROMPT="..."
#      COLOR_CLASSIFICATION_PROMPT="..."
#      COMPOSITION_ANALYSIS_PROMPT="..."
#      FACE_FORTUNE_PROMPT="..."
#      REVERSE_GEOCODING_PROMPT="..."

# ===== 管理后台认证配置 =====
# JWT_SECRET_KEY 和 ADMIN_PASSWORD_HASH 已移至 .env.secrets 文件
# 管理员账号
ADMIN_USERNAME=zywl

# ===== 微信配置 =====
WECHAT_APPID=wx519901dac7705111
# WECHAT_SECRET 和 WECHAT_TOKEN 已移至 .env.secrets 文件

# ===== 微信支付配置 =====
# WECHAT_PAY_MCHID 和 WECHAT_PAY_API_KEY 已移至 .env.secrets 文件
# 支付回调URL（微信支付成功后会调用此接口通知服务器）
WECHAT_PAY_NOTIFY_URL=https://www.xintuxiangce.top/api/v1/payment/notify

# ===== 支付价格配置 =====
# 测试价格配置
MEMBER_PRICE_TEST=0.10
CREDITS_PRICE_TEST=0.01
CREDITS_AMOUNT_TEST=1

# 正式价格配置
MEMBER_PRICE_PROD=9.90
CREDITS_PRICE_PROD=1
CREDITS_AMOUNT_PROD=10

# 价格模式切换（true=使用测试价格，false=使用正式价格）
USE_TEST_PRICE=false

# 套餐数量列表（用分号分隔）
CREDITS_AMOUNTS_TEST=1;5;10;50;100
CREDITS_AMOUNTS_PROD=10;20;50;100

# ===== 图像编辑结果图片URL配置 =====
# 图像编辑结果图片的基础URL（新服务器域名）
IMAGE_EDIT_BASE_URL=https://api.aifuture.net.cn

# ===== 图像编辑功能配置 =====
# 是否允许未关注公众号的用户使用修图功能（开启后不检查额度，不扣减额度）
# 设置为 true 时，用户无需关注公众号即可使用修图功能
# 设置为 false 时，必须关注公众号（有openid）才能使用
ALLOW_IMAGE_EDIT_WITHOUT_OPENID=false

# ===== 七牛云CDN配置 =====
# 用于上传图像编辑结果到七牛云CDN（生成永久URL，避免24小时过期）
# 如果未配置，将使用大模型返回的临时URL（24小时有效）
# QINIU_ACCESS_KEY 和 QINIU_SECRET_KEY 已移至 .env.secrets 文件
# 获取方式：登录 https://portal.qiniu.com/ 注册账号，创建AccessKey
QINIU_BUCKET_NAME=
# 七牛云CDN域名（如：https://cdn.example.com）
# 注意：域名需要配置CNAME指向七牛云分配的域名
QINIU_DOMAIN=

# ===== 地理位置API配置 =====
# GAODE_API_KEY 已移至 .env.secrets 文件
# 获取方式：登录 https://console.amap.com/ 注册开发者账号，创建应用后获取Key

# 高德地图API地址（通常不需要修改）
GAODE_API_URL=https://restapi.amap.com/v3/geocode/regeo

# Nominatim API地址（用于国外坐标的地理位置查询，不需要API Key）
NOMINATIM_API_URL=https://wwww.xintuzhaopian.com/api/reverse


# Nominatim API调用频率限制（秒/请求，避免超过API限制）
NOMINATIM_RATE_LIMIT=1.0

